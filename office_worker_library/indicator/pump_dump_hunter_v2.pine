//@version=6
indicator("PUMP & DUMP HUNTER v2", overlay=true, max_labels_count=100, max_lines_count=100)
// Еталон PUMP/DUMP поруч з ICT SMC HUNTER. EQ=0.5, OTE=0.786 (навпаки від Hunter).

// ══════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════
vol_mult    = input.float(2.0, "Obsyag spike (x)", minval=1.0, step=0.1)
sl_atr      = input.float(1.5, "Stop (x ATR)",     minval=0.5, step=0.1)
show_short  = input.bool(true,  "Pokazuvaty SHORT (DUMP)")
show_long   = input.bool(true,  "Pokazuvaty LONG (PUMP)")
tol_pct     = input.float(0.6,  "Tolerantnist rivnya %", minval=0.1, step=0.1)

// ══════════════════════════════════════════
// ЗОВНІШНІ РІВНІ (security)
// ══════════════════════════════════════════
d_h = request.security(syminfo.tickerid, "D",   high[1],  lookahead=barmerge.lookahead_on)
d_l = request.security(syminfo.tickerid, "D",   low[1],   lookahead=barmerge.lookahead_on)
d_o = request.security(syminfo.tickerid, "D",   open[1],  lookahead=barmerge.lookahead_on)
d_c = request.security(syminfo.tickerid, "D",   close[1], lookahead=barmerge.lookahead_on)
w_h = request.security(syminfo.tickerid, "W",   high[1],  lookahead=barmerge.lookahead_on)
w_l = request.security(syminfo.tickerid, "W",   low[1],   lookahead=barmerge.lookahead_on)
w_o = request.security(syminfo.tickerid, "W",   open[1],  lookahead=barmerge.lookahead_on)
w_c = request.security(syminfo.tickerid, "W",   close[1], lookahead=barmerge.lookahead_on)

d_bull = d_c > d_o
w_bull = w_c > w_o
d_rng  = d_h - d_l
eq     = d_bull ? d_h - d_rng * 0.5   : d_l + d_rng * 0.5
ote    = d_bull ? d_h - d_rng * 0.786 : d_l + d_rng * 0.786

// ══════════════════════════════════════════
// EMA / RSI / ATR
// ══════════════════════════════════════════
ema21   = ta.ema(close, 21)
ema55   = ta.ema(close, 55)
rsi     = ta.rsi(close, 14)
atr     = ta.atr(14)
vol_sma = ta.sma(volume, 20)

signal_min = 10
watch_min  = 6
fresh_pct  = 20.0

vol_spike = volume > vol_sma * vol_mult
vol_grow  = volume > volume[1] and volume[1] > volume[2]
vol_score = vol_spike ? 3 : vol_grow ? 1 : 0

// ══════════════════════════════════════════
// КОНТЕКСТ РІВНІВ
// ══════════════════════════════════════════
near_lvl(level, mult) =>
    not na(level) and math.abs(close - level) < close * tol_pct * mult / 100.0

near_ote     = near_lvl(ote, 1.0)
near_eq      = near_lvl(eq, 1.0)
near_d_low   = near_lvl(d_l, 1.0)
near_d_high  = near_lvl(d_h, 1.0)
near_w_low   = near_lvl(w_l, 1.5)
near_w_high  = near_lvl(w_h, 1.5)

lvl_l = near_w_low ? 3 : (near_d_low or (near_ote and d_bull)) ? 2 : (near_eq and d_bull) ? 1 : 0
if near_ote and d_bull
    lvl_l := math.max(lvl_l, 2)
lvl_s = near_w_high ? 3 : (near_d_high or (near_ote and not d_bull)) ? 2 : (near_eq and not d_bull) ? 1 : 0

// ══════════════════════════════════════════
// БАЛИ LONG (0–18)
// ══════════════════════════════════════════
delev = 0
for back = 1 to 15
    br = close[back] < open[back] and (open[back] - close[back]) / open[back] > 0.015 and volume[back] > vol_sma[back] * 1.8
    wd = (open[back] - low[back]) > (high[back] - close[back]) * 1.5 and volume[back] > vol_sma[back] * 1.3
    if br or wd
        conf = close > open and close > close[1]
        if conf
            delev := back <= 3 ? 3 : back <= 8 ? 2 : 1
        break

hi10    = ta.highest(high, 10)
lo10    = ta.lowest(low, 10)
squeeze = lo10 > 0 and (hi10 - lo10) / lo10 * 100.0 < 1.0
acc     = squeeze and vol_spike ? 3 : squeeze ? 2 : 0

skviz = rsi < 35 and rsi > rsi[1] and rsi[1] > rsi[2] ? 3 : rsi < 40 and rsi > rsi[1] ? 1 : 0

hh20   = ta.highest(high[1], 20)
brk_up = close > hh20 and close[1] <= hh20
hl     = low > low[1] and low[1] > low[2]
str_l  = brk_up ? 3 : hl and ema21 > ema55 ? 2 : hl ? 1 : 0

total_l = vol_score + delev + acc + skviz + str_l + lvl_l

lo20    = ta.lowest(low[1], 20)
fresh_l = lo20 > 0 and (close - lo20) / lo20 * 100.0 < fresh_pct
sig_pump = show_long and total_l >= signal_min and vol_spike and fresh_l and close > ema21
watch_l  = show_long and total_l >= watch_min and total_l < signal_min and fresh_l

// ══════════════════════════════════════════
// БАЛИ SHORT (0–18)
// ══════════════════════════════════════════
exhaust = 0
for back = 1 to 15
    bg = close[back] > open[back] and (close[back] - open[back]) / open[back] > 0.015 and volume[back] > vol_sma[back] * 1.8
    wu = (high[back] - close[back]) > (close[back] - low[back]) * 1.5 and volume[back] > vol_sma[back] * 1.3
    if bg or wu
        conf = close < open and close < close[1]
        if conf
            exhaust := back <= 3 ? 3 : back <= 8 ? 2 : 1
        break

overbuy = rsi > 65 and rsi < rsi[1] and rsi[1] < rsi[2] ? 3 : rsi > 60 and rsi < rsi[1] ? 1 : 0

ll20   = ta.lowest(low[1], 20)
hi20   = ta.highest(high[1], 20)
brk_dn = close < ll20 and close[1] >= ll20
lh     = high < high[1] and high[1] < high[2]
str_s  = brk_dn ? 3 : lh and ema21 < ema55 ? 2 : lh ? 1 : 0

total_s = vol_score + exhaust + acc + overbuy + str_s + lvl_s

fresh_s  = hi20 > 0 and (hi20 - close) / hi20 * 100.0 < fresh_pct
sig_dump = show_short and total_s >= signal_min and vol_spike and fresh_s and close < ema21
watch_s  = show_short and total_s >= watch_min and total_s < signal_min and fresh_s

// ══════════════════════════════════════════
// SL 7 bars ± sl_atr ATR | TP 1.5R / 3R / 5R | add 40%
// ══════════════════════════════════════════
sl_long  = ta.lowest(low, 7) - atr * sl_atr
sl_short = ta.highest(high, 7) + atr * sl_atr
risk_l   = close - sl_long
risk_s   = sl_short - close
tp1_long = close + risk_l * 1.5
tp2_long = close + risk_l * 3.0
tp3_long = close + risk_l * 5.0
add_long = close - risk_l * 0.4
tp1_short = close - risk_s * 1.5
tp2_short = close - risk_s * 3.0
tp3_short = close - risk_s * 5.0
add_short = close + risk_s * 0.4

var float entry_l = na
var float entry_s = na
if sig_pump
    entry_l := close
if sig_dump
    entry_s := close

continuation_l = not na(entry_l) and close > entry_l * 1.01 and volume > vol_sma * vol_mult and close > open and ema21 > ema55
continuation_s = not na(entry_s) and close < entry_s * 0.99 and volume > vol_sma * vol_mult and close < open and ema21 < ema55
retest_l       = not na(entry_l) and math.abs(close - entry_l) / entry_l * 100.0 < tol_pct and volume > vol_sma * vol_mult
retest_s       = not na(entry_s) and math.abs(close - entry_s) / entry_s * 100.0 < tol_pct and volume > vol_sma * vol_mult

// ══════════════════════════════════════════
// ПІДХІД / ВІДБІЙ
// ══════════════════════════════════════════
approach_sup = near_d_low or near_w_low or (near_eq and d_bull) or (near_ote and d_bull)
approach_res = near_d_high or near_w_high or (near_eq and not d_bull) or (near_ote and not d_bull)
bounce_sup   = (low <= d_l * (1.0 + tol_pct / 100.0) or low <= w_l * (1.0 + tol_pct * 1.5 / 100.0)) and close > open and close > low[1]
bounce_res   = (high >= d_h * (1.0 - tol_pct / 100.0) or high >= w_h * (1.0 - tol_pct * 1.5 / 100.0)) and close < open and close < high[1]

// ══════════════════════════════════════════
// МАЛЮВАННЯ
// ══════════════════════════════════════════
plot(eq,  "EQ",  color=color.new(color.yellow, 30), linewidth=1, style=plot.style_linebr)
plot(ote, "OTE", color=color.new(color.orange, 30), linewidth=1, style=plot.style_linebr)
plot(d_h, "D H", color=color.new(color.red, 60),   linewidth=1, style=plot.style_linebr)
plot(d_l, "D L", color=color.new(color.green, 60), linewidth=1, style=plot.style_linebr)
plot(w_h, "W H", color=color.new(color.maroon, 70), linewidth=1, style=plot.style_linebr)
plot(w_l, "W L", color=color.new(color.teal, 70),   linewidth=1, style=plot.style_linebr)

plotshape(sig_pump, title="PUMP", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="PUMP")
plotshape(sig_dump, title="DUMP", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="DUMP")
plotshape(watch_l,  title="WATCH L", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 40), size=size.tiny)
plotshape(watch_s,  title="WATCH S", style=shape.circle, location=location.abovebar, color=color.new(color.red, 40), size=size.tiny)

if sig_pump
    label.new(bar_index, low, "PUMP " + str.tostring(total_l) + "/18\nSL " + str.tostring(sl_long, format.mintick) + "\nTP1 " + str.tostring(tp1_long, format.mintick), style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
if sig_dump
    label.new(bar_index, high, "DUMP " + str.tostring(total_s) + "/18\nSL " + str.tostring(sl_short, format.mintick) + "\nTP1 " + str.tostring(tp1_short, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

var line ln_sl = na
var line ln_tp1 = na
var line ln_add = na
if sig_pump
    if not na(ln_sl)
        line.delete(ln_sl)
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_add)
        line.delete(ln_add)
    ln_sl  := line.new(bar_index, sl_long, bar_index + 20, sl_long, color=color.red, width=1, style=line.style_dashed)
    ln_tp1 := line.new(bar_index, tp1_long, bar_index + 20, tp1_long, color=color.green, width=1, style=line.style_dotted)
    ln_add := line.new(bar_index, add_long, bar_index + 20, add_long, color=color.blue, width=1, style=line.style_dotted)
if sig_dump
    if not na(ln_sl)
        line.delete(ln_sl)
    if not na(ln_tp1)
        line.delete(ln_tp1)
    if not na(ln_add)
        line.delete(ln_add)
    ln_sl  := line.new(bar_index, sl_short, bar_index + 20, sl_short, color=color.red, width=1, style=line.style_dashed)
    ln_tp1 := line.new(bar_index, tp1_short, bar_index + 20, tp1_short, color=color.green, width=1, style=line.style_dotted)
    ln_add := line.new(bar_index, add_short, bar_index + 20, add_short, color=color.blue, width=1, style=line.style_dotted)

// ══════════════════════════════════════════
// ТАБЛИЦЯ
// ══════════════════════════════════════════
var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "PUMP/DUMP v2", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, syminfo.ticker, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "LONG", text_color=color.lime, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(total_l) + "/18", text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 2, "SHORT", text_color=color.red, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(total_s) + "/18", text_color=color.red, text_size=size.small)
    table.cell(t, 0, 3, "EQ", text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(eq, format.mintick), text_color=color.yellow, text_size=size.tiny)
    table.cell(t, 0, 4, "OTE", text_color=color.orange, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(ote, format.mintick), text_color=color.orange, text_size=size.tiny)
    table.cell(t, 0, 5, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(rsi, "#.0"), text_color=color.gray, text_size=size.tiny)

// ══════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════
alertcondition(sig_pump,        "PUMP",              "PUMP signal! Score " + str.tostring(total_l))
alertcondition(sig_dump,        "DUMP",              "DUMP signal! Score " + str.tostring(total_s))
alertcondition(watch_l,         "WATCH PUMP",        "Watch PUMP " + str.tostring(total_l) + "/18")
alertcondition(watch_s,         "WATCH DUMP",        "Watch DUMP " + str.tostring(total_s) + "/18")
alertcondition(continuation_l,  "CONTINUATION L",    "Pump continuation LONG")
alertcondition(continuation_s,  "CONTINUATION S",    "Dump continuation SHORT")
alertcondition(retest_l,        "RETEST L",          "Retest / add zone LONG (40% to SL)")
alertcondition(retest_s,        "RETEST S",          "Retest / add zone SHORT (40% to SL)")
alertcondition(bounce_sup,      "VIDBII L",          "Vidbiiv vid pidtrymky!")
alertcondition(bounce_res,      "VIDBII S",          "Vidbiiv vid oporu!")
alertcondition(approach_sup,    "PIDZHY-MANNYA L",   "Pidkhid do klyuchovoi pidtrymky!")
alertcondition(approach_res,    "PIDZHY-MANNYA S",   "Pidkhid do klyuchovoi oporu!")
